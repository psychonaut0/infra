# copyparty — psy instance. Runs as uid 1000, serves the psy Samba tree.
# Deployed to /opt/stacks/ct-files/copyparty/psy/copyparty.conf on ct-files.
#
# This directory is ALSO the container's /cfg, so it receives the argon2 salt
# and sessions.db at runtime. Do NOT change the container's `user:` after
# accounts exist — the salt is uid-sensitive and every hash silently breaks.
# Runbook: stacks/ct-files/README.md

[global]
  # --- listen ---
  p: 3923

  # --- indexing ---
  # e2dsa = filesystem scan + index; e2ts = media tags.
  # Directory LISTINGS do not come from this index — they are a live
  # os.scandir per request — so Samba writes appear instantly regardless.
  # The index only backs search.
  e2dsa
  e2ts
  # Index name/size/mtime only, never file contents. Without this the first
  # scan reads all 51 GB through FUSE on one core. Full search still works;
  # only search-by-content-hash and dedup are lost, and neither is wanted
  # here.
  no-hash: .
  # Never index Samba's recycle bin (17 GB here) or our own cache dir.
  no-idx: (^|/)\.(deleted|hist)/
  # Re-scan hourly to keep search fresh. copyparty has NO inotify anywhere,
  # which is precisely why mergerfs's unreliable FUSE inotify is a non-issue.
  re-maxage: 3600

  # --- index + thumbnail cache locations ---
  # dbpath MUST stay off the mergerfs pool: SQLite on FUSE corrupts
  # (upstream issue #919). Both live on the CT rootfs via a bind mount, and
  # deliberately outside /opt/stacks so ct-backup does not ship thumbnails.
  dbpath: /var/copyparty/db
  hist: /var/copyparty/hist

  # --- thumbnails ---
  # One thumbnail thread. ct-files has 2 vCPU and runs TWO copyparty
  # containers, so the per-container default of CORES would put 4 threads on
  # 2 cores with smbd competing.
  th-mt: 1
  th-maxage: 604800
  th-clean: 43200
  # Media-tag readers also default to CORES and spawn ffprobe. Two containers
  # x 2 workers = 4 ffprobe processes on 2 cores, competing with smbd. Pin to
  # 1, per the maintainer's guidance for constrained hosts (issue #1332).
  # hash-mt is deliberately not set: `no-hash: .` above makes it moot.
  mtag-mt: 1
  # psd removed from both decoder lists: layered Photoshop files decode to
  # well over 1 GB and would OOM-kill the container inside its 640m
  # mem_limit. Lists copied verbatim from `--help` on copyparty v1.20.19,
  # minus psd. RE-CHECK AFTER A MAJOR IMAGE UPGRADE — new extensions added
  # upstream are silently omitted until these are refreshed.
  th-r-pil: avif,avifs,blp,bmp,cbz,dcx,dds,dib,emf,eps,epub,fits,flc,fli,fpx,gif,heic,heics,heif,heifs,icns,ico,im,j2p,j2k,jp2,jpeg,jpg,jpx,jxl,pbm,pcx,pgm,png,pnm,ppm,qoi,sgi,spi,tga,tif,tiff,webp,wmf,xbm,xpm
  th-r-ffi: apng,avif,avifs,bmp,cbz,dds,dib,epub,fit,fits,fts,gif,hdr,heic,heics,heif,heifs,icns,ico,jp2,jpeg,jpg,jpx,jxl,pbm,pcx,pfm,pgm,png,pnm,ppm,qoi,sgi,tga,tif,tiff,webp,xbm,xpm

  # --- auth ---
  # MANDATORY. The default is `none`, i.e. plaintext passwords in this file.
  ah-alg: argon2

  # --- reverse-proxy real IP ---
  # LOAD-BEARING: every ban rule keys on client IP. Trusted upstreams are
  # cloudflared (.6, public path) and Caddy (.12, LAN path) ONLY.
  # Never `lan` — copyparty is directly reachable on the LAN, so a lan-wide
  # trust would let any host forge this header to evade a ban or ban a third
  # party. copyparty's own code warns about this (httpcli.py:499).
  xff-hdr: cf-connecting-ip
  xff-src: 192.168.3.6, 192.168.3.12
  # Defaults to 9999999 (deliberately out of bounds) — must be set.
  rproxy: 1

  # --- advisory feed ---
  # Default-disabled. This is the early-warning channel for new CVEs.
  # Do NOT add `vc-exit` (present in upstream's sample config) — it shuts the
  # server down on a warning instead of just displaying it.
  vc-url: https://api.copyparty.eu/advisories

  # --- share links ---
  # REQUIRED to enable sharing at all: --shr defaults to empty, which disables
  # the feature and hides the UI control entirely.
  # shr-db defaults to /cfg/copyparty/shares.db, i.e. inside the backed-up /cfg,
  # so shares survive restarts and restores.
  # shr-who defaults to `auth` (any authenticated user) — one account per
  # instance, so that is just the owner.
  # shr-site is important: without it a link created while browsing the .lan
  # hostname embeds that hostname and is useless to anyone outside the LAN.
  shr: /share
  shr-site: https://drive.ncsp.dev/

  # --- ui ---
  grid

  # Deliberately NOT set, per the decision to start simple and add Authelia
  # later (see spec "Deliberately minimal, by decision"):
  #   usernames  — login is password-only; one account per instance, so there
  #                is nothing to disambiguate.
  #   pw-urlp    — ?pw= in URLs stays accepted; disabling it breaks some
  #                WebDAV clients, which are the mobile story.
  # Deliberately NOT enabled, ever: ftp, dk (dirkeys), dedup/hardlink/reflink,
  # th-bwrap, vc-exit. Recent advisories hit ftp and dk specifically.

[accounts]
  # Generate with the runbook in stacks/ct-files/README.md. The hash is only
  # valid against the salt in THIS directory, generated as THIS uid.
  psy: REPLACE_WITH_ARGON2_HASH

[/]
  /w
  accs:
    rwmd: psy
  flags:
    # Matches the modes already present on this tree (644 / 755).
    chmod_f: 644
    chmod_d: 755
