# Frigate MQTT broker password (Home Assistant MQTT user)
FRIGATE_MQTT_PASSWORD=your-mqtt-password-here

# RTSP password for the IP cameras (user "frigate" on 192.168.2.10/11/12)
FRIGATE_RTSP_PASSWORD=your-camera-rtsp-password-here

# go2rtc restream auth (server that re-serves cameras to Frigate at 127.0.0.1:8554)
FRIGATE_RESTREAM_PASSWORD=your-go2rtc-restream-password-here
