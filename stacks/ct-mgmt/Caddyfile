# Reverse proxy for local services
# All on HTTP port 80 — access via http://service.lan

http://portainer.lan {
	reverse_proxy portainer:9000
}

http://dns.lan {
	reverse_proxy 192.168.3.5:80
}

nvr.lan {
	tls internal
	reverse_proxy https://192.168.3.7:8971 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

http://nvr.lan {
	reverse_proxy https://192.168.3.7:8971 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

proxmox.lan {
	tls internal
	reverse_proxy https://192.168.3.2:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

proxmox-node.lan {
	tls internal
	reverse_proxy https://192.168.3.3:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

http://jellyfin.lan {
	reverse_proxy 192.168.3.8:8096
}

immich.lan {
	tls internal
	reverse_proxy 192.168.3.9:2283
}

http://immich.lan {
	reverse_proxy 192.168.3.9:2283
}

homeassistant.lan {
	tls internal
	reverse_proxy http://192.168.3.10:8123
}

http://homeassistant.lan {
	reverse_proxy http://192.168.3.10:8123
}

http://files.lan {
	reverse_proxy 192.168.3.11:8080
}

http://home.lan {
	reverse_proxy dashboard:3000
}

http://status.lan {
	reverse_proxy gatus:8080
}
