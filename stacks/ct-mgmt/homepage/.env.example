# Homepage widget API tokens
# Copy to .env on ct-mgmt at /opt/stacks/ct-mgmt/homepage/.env

# Proxmox: Datacenter > API Tokens > create token for user@pam
HOMEPAGE_VAR_PROXMOX_USER=user@pam!homepage
HOMEPAGE_VAR_PROXMOX_PASS=your-token-here

# Jellyfin: Settings > API Keys > create
HOMEPAGE_VAR_JELLYFIN_KEY=your-key-here

# Immich: User Settings > API Keys > create
HOMEPAGE_VAR_IMMICH_KEY=your-key-here

# Home Assistant: Profile > Long-Lived Access Tokens > create
HOMEPAGE_VAR_HASS_KEY=your-token-here

# Pi-hole: Settings > API > Show API token
HOMEPAGE_VAR_PIHOLE_KEY=your-key-here
