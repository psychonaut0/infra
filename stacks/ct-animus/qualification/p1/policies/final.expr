# Positive mandatory Prompt validation. No client prompt value is authority.
try:
    import multiprocessing
    import re
    import time
    from authentik.events.signals import get_login_event
    from authentik.flows.views.executor import SESSION_KEY_PLAN
    process = multiprocessing.current_process()
    if type(process).__name__ != "_MainProcess" or process.daemon:
        return False
    http = request.http_request
    plan = http.session[SESSION_KEY_PLAN]
    binding = plan.bindings[0]
    if binding.stage.name != "p1-mechanism-normal-final" or binding.target_id.hex != plan.flow_pk:
        return False
    context = plan.context
    if "is_restored" in context or "is_redirected" in context:
        return False
    state = context.get("hub_p1_execution")
    expected = {"policy", "flow", "nonce", "factor_time", "initial_session_user", "initial_login_event"}
    if not isinstance(state, dict) or set(state) != expected:
        return False
    if state["policy"] != "animus-password-totp-mechanism-v2" or state["flow"] != plan.flow_pk:
        return False
    if not isinstance(state["nonce"], str) or not re.fullmatch(r"[0-9a-f]{32}", state["nonce"]):
        return False
    started = state["factor_time"]
    if type(started) is not int or started <= 0 or not 0 <= time.time() - started <= 300:
        return False
    principal = http.user.pk if http.user.is_authenticated else None
    event = get_login_event(http) if principal is not None else None
    if principal != state["initial_session_user"] or (str(event.pk) if event else None) != state["initial_login_event"]:
        return False
    user = context.get("pending_user")
    if user is None or not user.pk or not user.is_active or user.is_superuser:
        return False
    if not ak_is_group_member(user, name="p1-mechanism-normal") or context.get("auth_method") != "password":
        return False
    args = context.get("auth_method_args")
    if not isinstance(args, dict) or not isinstance(args.get("mfa_devices"), list) or not args["mfa_devices"]:
        return False
    for device in args["mfa_devices"]:
        if type(device).__name__ != "TOTPDevice" or not device.confirmed or device.user_id != user.pk:
            return False
    marker = {"hub_authentication_policy": state["policy"], "hub_factor_time": started,
              "hub_policy_flow": state["flow"], "hub_policy_execution": state["nonce"],
              "hub_policy_subject": user.pk}
    if any(key in args and args[key] != value for key, value in marker.items()):
        return False
    args.update(marker)
    http.session[SESSION_KEY_PLAN] = plan
    return True
except Exception:
    return False
