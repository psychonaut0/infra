#!/bin/bash
# dev-task — run Claude Code headless under a transient systemd user unit, so
# work continues with no terminal attached. Results are PULLED, not pushed:
# there is deliberately no notification service.
#
# The log directory, not systemd, is authoritative for `list`. Transient
# `systemd-run --user` units default to CollectMode=inactive: a unit that
# exits cleanly is garbage-collected within seconds, so `systemctl --user
# list-units` goes blind to success almost immediately -- indistinguishable
# from a task that never ran. Logs persist. `run` therefore wraps the command
# so its own exit code is appended as the last line of the log, and `list`
# derives status from that trailing line (falling back to the live unit's
# ActiveState only while no such line exists yet, i.e. still running).
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dev-task"
mkdir -p "$STATE_DIR"

usage() {
  cat >&2 <<USAGE
usage:
  dev-task run <name> "<prompt>"   start a headless task
  dev-task list                    show task states
  dev-task log <name>              tail a task's output
USAGE
  exit 2
}

cmd_run() {
  local name="${1:?task name required}"; shift
  local prompt="${*:?prompt required}"
  local log="$STATE_DIR/${name}.log"
  : > "$log"
  # exec redirects the wrapper's own stdout+stderr (and therefore claude's,
  # once it execs) to append to the log; $0 inside the wrapper is the log
  # path, passed positionally rather than interpolated into the script text
  # so neither it nor the prompt need special quoting. The trailing
  # "[dev-task] exit=N" line is what makes a finished run's outcome
  # recoverable after the unit itself has been collected.
  #
  # $$ec / $$ below (not $ec / $) is deliberate, not a typo: systemd performs
  # its own ${VAR}/$VAR specifier substitution on the ExecStart command line
  # before the shell ever sees it, and "ec" parses as a valid variable name
  # to systemd (unset in the unit's environment, so it silently becomes an
  # empty string -- confirmed via `journalctl --user`, which logs "Referenced
  # but unset environment variable ... : ec"). $? and $0 survive untouched
  # because "?" and "0" aren't valid identifier characters, but any named
  # variable we introduce ourselves is not safe unless escaped. systemd's
  # own escape for a literal "$" is "$$" (systemd.service(5)); that literal
  # "$" is what then reaches bash as an ordinary variable reference.
  systemd-run --user --unit="dev-task-${name}" \
    --working-directory="$PWD" \
    --setenv=HOME="$HOME" \
    /bin/bash -c 'exec >>"$0" 2>&1; claude -p "$1"; ec=$?; echo "[dev-task] exit=$$ec"; exit "$$ec"' \
    "$log" "$prompt"
  echo "started dev-task-${name} (log: ${log})"
}

# Reads the trailing "[dev-task] exit=N" line out of a log, if present.
# Prints nothing if the task is still running (no such line yet).
_last_exit() {
  local log="$1" line last=""
  while IFS= read -r line; do
    case "$line" in
      '[dev-task] exit='*) last="${line#*exit=}" ;;
    esac
  done < "$log"
  printf '%s' "$last"
}

cmd_list() {
  local log name mtime exit_code status active found=0
  for log in "$STATE_DIR"/*.log; do
    [ -e "$log" ] || continue
    found=1
    name="$(basename "$log" .log)"
    mtime="$(date -r "$log" '+%Y-%m-%d %H:%M:%S')"
    exit_code="$(_last_exit "$log")"
    if [ -n "$exit_code" ]; then
      if [ "$exit_code" = "0" ]; then
        status="done (exit 0)"
      else
        status="failed (exit ${exit_code})"
      fi
    else
      # No exit line yet: still running, unless the unit itself is gone
      # without ever recording one (killed, or crashed before the wrapper
      # could append its line).
      active="$(systemctl --user show "dev-task-${name}" --property=ActiveState --value 2>/dev/null || true)"
      case "$active" in
        active|activating|reloading) status="running" ;;
        *) status="unknown (no exit recorded, unit not found)" ;;
      esac
    fi
    printf '%-24s %-20s %s\n' "$name" "$mtime" "$status"
  done
  if [ "$found" -eq 0 ]; then
    echo "no tasks" >&2
  fi
}

cmd_log() {
  local name="${1:?task name required}"
  tail -f "$STATE_DIR/${name}.log"
}

case "${1:-}" in
  run)  shift; cmd_run "$@" ;;
  list) cmd_list ;;
  log)  shift; cmd_log "$@" ;;
  *)    usage ;;
esac
