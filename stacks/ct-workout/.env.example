# Copy to /opt/stacks/ct-workout/.env on the CT and fill with REAL long-random secrets.
# .env is gitignored; ct-backup captures it nightly.

POSTGRES_USER=workout
POSTGRES_PASSWORD=__SET_A_LONG_RANDOM__
POSTGRES_DB=workout_tracker

# Client-reachable PowerSync endpoint (the phone, via Caddy/.lan over Tailscale).
# This is the URL the Go API returns to clients as the sync endpoint — must be
# reachable from the phone, NOT an in-cluster name.
POWERSYNC_URL=http://workout-sync.lan

# uid:gid that owns ./secrets/jwt_private_key.pem (mode 0600) on the CT, so the
# non-root server container can read the bind-mounted key.
SERVER_UID=1000
SERVER_GID=1000

# --- PowerSync (sync service) ---
# Password for the powersync_role replication user. Migration 00004 creates the
# role as NOLOGIN/no-password; the one-time deploy step runs
#   ALTER ROLE powersync_role LOGIN PASSWORD '<this value>';
PS_REPLICATION_PASSWORD=__SET_A_LONG_RANDOM__
# Dedicated bucket-storage Postgres (its own container/db).
POWERSYNC_STORAGE_USER=powersync
POWERSYNC_STORAGE_PASSWORD=__SET_A_LONG_RANDOM__
POWERSYNC_STORAGE_DB=powersync_storage
# Admin API token for the PowerSync service's admin routes (any long random string).
PS_ADMIN_API_TOKEN=__SET_A_LONG_RANDOM__
