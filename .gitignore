**/.env

# runtime state — lives on the CTs, never in git
stacks/ct-ha/config/
stacks/ct-ha/mosquitto/data/
stacks/ct-ha/mosquitto/log/
stacks/ct-ha/mosquitto/config/passwd
# ESPHome: track sanitized device YAMLs; keep secrets + build cache out (ESPHome convention)
stacks/ct-tools/esphome/config/secrets.yaml
stacks/ct-tools/esphome/config/.esphome/
stacks/ct-tools/esphome/config/*.bak
stacks/ct-tools/esphome/config/**/*.bak

# Git worktrees
.worktrees/

# Go CLI build artifacts
cli/bin/

# Local Claude context — real values behind redacted placeholders in CLAUDE.md
CLAUDE.local.md

# Private keys & key material — never commit
*.key
*.pem
id_rsa
id_ed25519
authorized_keys
# conventional secret-holding dirs (defense in depth beyond the globs above)
**/secrets/

# Per-instance script output (regenerated by scripts/immich-raw-stack.py)
scripts/immich-raw-pairs.csv

# subagent-driven-development scratch (progress ledger)
.superpowers/

# Per-area private notes (sensitive operational detail kept out of the public repo)
*.local.md

# API tokens and tunnel credentials (never committed — this repo is public)
*.token
**/credentials.json
